{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "frozi.lol Help",
  "colors": {
    "primary": "#4da6ff",
    "light": "#4da6ff",
    "dark": "#0080ff"
  },
  "banner": {
    "content": "Please ensure that its very early stage of documentation and will be updated regularly. If you want to help by contributing go to the [github repository](https://github.com/frozi-lol/docs)",
    "dismissible": true
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "development"]
          },
          {
            "group": "Customization",
            "pages": ["essentials/settings", "essentials/navigation"]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/api-keys"
            ]
          },
          {
            "group": "Leaderboard Endpoints",
            "pages": ["api-reference/endpoint/leaderboard"]
          },
          {
            "group": "Lookup Endpoints",
            "pages": [
              "api-reference/endpoint/lookup-username",
              "api-reference/endpoint/lookup-uid",
              "api-reference/endpoint/lookup-auth-id",
              "api-reference/endpoint/lookup-links"
            ]
          },
          {
            "group": "Error Responses",
            "pages": ["api-reference/errors"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://frozi.lol"
      },
      {
        "label": "Developer Platform",
        "href": "https://frozi.lol/dashboard/developer"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://frozi.lol/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/frozi-lol/docs",
      "discord": "https://discord.gg/ttURmxuR4T"
    }
  },
  "description": "Need assistance? Start by browsing answers to frequently asked questions. Whether you're configuring an integration, managing user data, or exploring API capabilities — we’ve got your back.",
  "appearance": {
    "default": "system"
  }
}
